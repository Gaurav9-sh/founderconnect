// FounderConnect — Prisma schema
// Note: SQLite doesn't support Prisma enums, so enum-like fields are stored
// as strings. Allowed values are defined in lib/enums.ts and validated at
// the service layer with Zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   // Role: FOUNDER | MENTOR | INVESTOR
  createdAt    DateTime @default(now())

  profile Profile?

  startups            Startup[]            @relation("FounderStartups")
  sentRequests        Connection[]         @relation("SentRequests")
  receivedRequests    Connection[]         @relation("ReceivedRequests")
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  pitchInterests      PitchInterest[]
  notifications       Notification[]
  posts               Post[]
  postLikes           PostLike[]
  comments            Comment[]
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline      String?
  bio           String?
  location      String?
  skills        String?  // comma-separated
  experience    String?
  website       String?
  linkedin      String?
  twitter       String?
  avatarUrl     String?
  investmentFocus   String?  // comma-separated sectors
  checkSizeMin      Int?
  checkSizeMax      Int?
  mentorshipAreas   String?

  updatedAt DateTime @updatedAt
}

model Startup {
  id            String   @id @default(cuid())
  founderId     String
  founder       User     @relation("FounderStartups", fields: [founderId], references: [id], onDelete: Cascade)
  name          String
  tagline       String
  description   String
  category      String
  stage         String   // StartupStage: IDEA | MVP | EARLY_TRACTION | GROWTH | SCALING
  location      String?
  website       String?
  logoUrl       String?
  fundingGoal   Int?
  raisedAmount  Int?     @default(0)
  traction      String?
  pitchDeckUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  interests PitchInterest[]
}

model Connection {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // ConnectionStatus
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId, createdAt])
}

model PitchInterest {
  id         String   @id @default(cuid())
  startupId  String
  startup    Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  investorId String
  investor   User     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  status     String   @default("INTERESTED") // InterestStatus
  note       String?
  createdAt  DateTime @default(now())

  @@unique([startupId, investorId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Post {
  id             String     @id @default(cuid())
  authorId       String
  author         User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  imageUrl       String?
  originalPostId String?
  originalPost   Post?      @relation("Forwards", fields: [originalPostId], references: [id], onDelete: SetNull)
  forwards       Post[]     @relation("Forwards")
  likes          PostLike[]
  comments       Comment[]
  createdAt      DateTime   @default(now())

  @@index([createdAt])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}
